# 复制为 .env 后填写；不填 Key 时自动进入离线 mock 模式
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# auto = 有 Key 走真实模型，无 Key 走离线 mock；mock = 强制离线
AI_MODE=auto
# 全局同时进行的 AI 请求上限（对应 README §6.1）
AI_MAX_CONCURRENCY=4
AI_TIMEOUT=60
# 决策 Agent 校验失败后的最大重试轮数
DECISION_MAX_RETRY=2
# SQLite 存档位置
DB_PATH=./data/campusmind.db
